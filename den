48         public static async Task<List<Server>> GetCmdbServersList()
49         {
50             using var httpClient = new HttpClient()
51             {
52                 Timeout = TimeSpan.FromMinutes(5) // ahora espera hasta 5 minutos
53             };

54             int maxRetries = 3;   // número de reintentos
55             int delaySeconds = 5; // espera entre intentos
56             for (int intento = 1; intento <= maxRetries; intento++)
57             {
58                 try
59                 {
60                     var byteArray = Encoding.ASCII.GetBytes($"{_apiSettings.User}:{_apiSettings.Password}");
61                     httpClient.DefaultRequestHeaders.Authorization =
62                         new AuthenticationHeaderValue("Basic", Convert.ToBase64String(byteArray));
63                     httpClient.DefaultRequestHeaders.Clear();
64                     httpClient.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));

65                     Console.WriteLine($"Intento {intento} de {maxRetries} para obtener la lista de servidores CMDB...");

66                     HttpResponseMessage response = await httpClient.GetAsync(_apiSettings.Url);

67                     if (response.IsSuccessStatusCode)
68                     {
69                         string responseBody = await response.Content.ReadAsStringAsync();
70                         var apiResponse = JsonConvert.DeserializeObject<CmdbResponse>(responseBody);
71                         var serverList = apiResponse?.Result ?? new List<Server>();

72                         // ✅ Eliminar duplicados por Name
73                         var uniqueServerList = serverList
74                             .GroupBy(s => s.Name)
75                             .Select(g => g.First())
76                             .ToList();

77                         return uniqueServerList;
78                     }
79                     else
80                     {
81                         Console.WriteLine($"✘ Error HTTP {response.StatusCode} en intento {intento}");
82                     }
83                 }
84                 catch (Exception ex)
85                 {
86                     Console.WriteLine($"⚠️ Error en intento {intento}: {ex.Message}");
87                     await Task.Delay(delaySeconds * 1000);
88                 }
89             }
90                 catch (TaskCanceledException ex)
91                 {
92                     Console.WriteLine($"⏰ Timeout en intento {intento}: {ex.Message}");
93                     if (intento == maxRetries) throw;
94                 }
95                 catch (Exception ex)
96                 {
97                     Console.WriteLine($"✘ Error en intento {intento}: {ex.Message}");
98                     if (intento == maxRetries) throw;
99                 }

100                 // Espera antes de reintentar
101                 Console.WriteLine($"⏳ Esperando {delaySeconds} segundos antes del reintento...");
102                 await Task.Delay(TimeSpan.FromSeconds(delaySeconds));
103             }

104             return new List<Server>(); // si todo falla, retorna lista vacía
105         }

106         public static async Task MatchEntitiesInfo(List<Server> serverList)
107         {
108             EntitiesDB entitiesDB = new EntitiesDB(_connectionString);
109             var entitiesList = await entitiesDB.GetEntities();

110             var normalizedEntities = new ConcurrentDictionary<string, List<EntitySchema>>();

111             foreach (var kvp in entitiesList)
112             {
113                 var keyHostname = kvp.Key.Split('.')[0].Trim().ToUpper();
114                 normalizedEntities.TryAdd(keyHostname, kvp.Value);
115             }

116             Parallel.ForEach(serverList, server =>
117             {
118                 if (!string.IsNullOrEmpty(server.Name))
119                 {
120                     string hostname = server.Name.Trim().ToUpper();
121                     bool matchFound = false;

122                     if (normalizedEntities.TryGetValue(hostname, out var matchedEntities))
123                     {
124                         _serversWithEntities.Add(new ServerWithEntities
125                         {
126                             Server = server,
127                             Entities = matchedEntities
128                         });
129                         matchFound = true;
130                     }
131                     if (matchFound)
132                     {
133                         normalizedEntities.TryRemove(hostname, out _);
134                         matchFound = true;
135                     }

136                     if (!matchFound)
137                     {
138                         _serversNoMatch.Add(server);
139                     }

140                     Console.WriteLine($"Procesando servidores: {serverList.IndexOf(server) + 1}/{serverList.Count}");
141                 }
142             });

143             foreach (var remainingEntities in normalizedEntities.Values)
144             {
145                 foreach (var entity in remainingEntities)
146                 {
147                     _serversNoMatchDyn.Add(entity);
148                 }
149             }

150             _serversNoMatchDyn = _serversNoMatchDyn
151                 .Where(entity => entity.ManagementZones != null &&
152                                  entity.ManagementZones.Any(zone => zone.Name != null &&
153                                      zone.Name.IndexOf("Premise", StringComparison.OrdinalIgnoreCase) >= 0))
154                 .ToList();
155             Console.WriteLine($"✅ Entidades con match {_serversWithEntities.Count}");
156             Console.WriteLine($"⚠️ Entidades que no hicieron match en cmdb {_serversNoMatch.Count}");
157             Console.WriteLine($"❌ Entidades que no hicieron match en dynatrace {_serversNoMatchDyn.Count}");
158         }

