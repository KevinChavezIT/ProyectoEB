174         // Condición para hacer el match con los Inventario Monitoreados
175         private static string NormalizeHost(string name)
176         {
177             if (String.IsNullOrWhiteSpace(name)) return string.Empty;

178             name = name.Trim();

179             // Quitar dominio, si viene: HOST.DOMINIO.COM → HOST
180             int dot = name.IndexOf('.');
181             if (dot > 0) name = name[..dot];
182             return name.ToUpperInvariant();
183         }

184         private static HashSet<string> LoadInventoryHostnames(string inventoryPath, string sheetName = "Hoja1")
185         {
186             var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
187             using var inv = new ExcelPackage(new FileInfo(inventoryPath));
188             var ws = inv.Workbook.Worksheets[sheetName];
189             if (ws == null) return set;

190             int r = 2; // A1 = encabezado HOSTNAME
191             while (true)
192             {
193                 var raw = ws.Cells[r, 1].Text;
194                 if (string.IsNullOrWhiteSpace(raw)) break;
195                 set.Add(NormalizeHost(raw));
196                 r++;
197             }
198             return set;
199         }

200         // Sistema Operativo–Versión
201         private static string NormalizeSoVersion(string s)
202         {
203             if (string.IsNullOrWhiteSpace(s)) return string.Empty;
204             s = s.Trim().ToUpperInvariant(); // Todo en mayúscula

205             // Unificar guiones y espacios
206             s = s.Replace("--", "-").Replace(" -", "-").Replace("- ", "-")
207                  .Replace("  ", " ").Replace("_", "-");

208             // Quitar caracteres raros, dejar solo letras, números, guiones, puntos y espacios
209             var sb = new System.Text.StringBuilder();
210             foreach (char c in s)
211             {
212                 if (char.IsLetterOrDigit(c) || c == '-' || c == '.' || c == ' ')
213                     sb.Append(c);
214             }
215             return sb.ToString().Trim();
216         }
217             s = sb.ToString();

218             // Quitar dobles espacios
219             while (s.Contains("  ")) s = s.Replace("  ", " ");

220             return s.Trim();
221         }

222         // Carga un diccionario: Clave = "Sistema Operativo–Versión" normalizado, valor = "SI"/"NO"/"VERIFICAR"
223         private static Dictionary<string, string> LoadPolicyBySo(string path, string sheet = "Hoja1")
224         {
225             var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
226             using var pkg = new OfficeOpenXml.ExcelPackage(new FileInfo(path));
227             var ws = pkg.Workbook.Worksheets[sheet];
228             if (ws == null) return map;

229             int r = 2; // Empieza en la fila 2 (A: SO–Versión, B: SI/NO/VERIFICAR)
230             while (true)
231             {
232                 var raw = ws.Cells[r, 1].Text;
233                 if (string.IsNullOrWhiteSpace(raw)) break;

234                 var val = ws.Cells[r, 2].Text?.Trim().ToUpperInvariant();
235                 if (string.IsNullOrWhiteSpace(val)) val = "VERIFICAR";
236                 var norm = NormalizeSoVersion(raw);
237                 if (!map.ContainsKey(norm))
238                     map[norm] = val;

239                 r++;
240             }
241             return map;
242         }

243         // Lee un Excel de catálogo con columnas: A = HostName, B = Estado operativo (Operativo/Retirado/...)
244         private static Dictionary<string, string> LoadOperationalStatus(string path, string sheet = "Hoja1")
245         {
246             var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
247             using var pkg = new OfficeOpenXml.ExcelPackage(new FileInfo(path));
248             var ws = pkg.Workbook.Worksheets[sheet];
249             if (ws == null) return map;

250             int r = 2; // encabezados en fila 1
251             while (true)
252             {
253                 var rawName = ws.Cells[r, 1].Text; // HostName
254                 if (string.IsNullOrWhiteSpace(rawName)) break;
255                 var status = ws.Cells[r, 2].Text?.Trim();
256                 if (string.IsNullOrWhiteSpace(status)) status = "SIN DATO";

257                 var key = NormalizeHost(rawName);
258                 if (!map.ContainsKey(key))
259                     map[key] = status;

260                 r++;
261             }
262             return map;
263         }

